# Universal RAG Pipeline - Environment Variables
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# EMBEDDING PROVIDERS
# =============================================================================

# OpenAI Embeddings (text-embedding-3-large, text-embedding-3-small, text-embedding-ada-002)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Embeddings (text-embedding-004)
GOOGLE_API_KEY=your-google-api-key-here

# Cohere Embeddings (embed-english-v3.0, embed-multilingual-v3.0)
COHERE_API_KEY=your-cohere-api-key-here

# HuggingFace Embeddings (for API usage, not needed for local models)
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# =============================================================================
# LLM PROVIDERS
# =============================================================================

# OpenAI LLMs (gpt-4, gpt-4-turbo, gpt-3.5-turbo, gpt-4o, etc.)
# OPENAI_API_KEY=sk-your-openai-api-key-here  # (already set above)

# Anthropic Claude (claude-3-5-sonnet, claude-3-opus, claude-3-sonnet, claude-3-haiku)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google Gemini (gemini-1.5-pro, gemini-1.5-flash, gemini-pro)
# GOOGLE_API_KEY=your-google-api-key-here  # (already set above)

# Cohere LLMs (command-r-plus, command-r, command, command-light)
# COHERE_API_KEY=your-cohere-api-key-here  # (already set above)

# =============================================================================
# LOCAL LLM/EMBEDDING SERVERS
# =============================================================================

# Ollama (for local models like llama2, mistral, codellama, nomic-embed-text)
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# VECTOR DATABASE PROVIDERS (Optional - for cloud-based solutions)
# =============================================================================

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=your-pinecone-environment

# Qdrant Cloud
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_URL=https://your-cluster.qdrant.io

# Weaviate Cloud
WEAVIATE_API_KEY=your-weaviate-api-key-here
WEAVIATE_URL=https://your-cluster.weaviate.network

# =============================================================================
# PIPELINE CONFIGURATION (Optional - override defaults)
# =============================================================================

# Default embedding provider (openai, google, huggingface, cohere, ollama)
RAG_EMBEDDING_PROVIDER=openai

# Default embedding model
RAG_EMBEDDING_MODEL=text-embedding-3-large

# Default LLM provider (openai, anthropic, google, cohere, ollama)
RAG_LLM_PROVIDER=openai

# Default LLM model
RAG_LLM_MODEL=gpt-4

# Default vector store (chroma, faiss, pinecone, qdrant, weaviate)
RAG_VECTOR_STORE=chroma

# Vector store persistence directory
RAG_PERSIST_DIR=./vectorstore_data

# Chunk size (in tokens)
RAG_CHUNK_SIZE=800

# Chunk overlap (in tokens)
RAG_CHUNK_OVERLAP=100

# Number of documents to retrieve
RAG_TOP_K=5

# Enable verbose logging (true/false)
RAG_VERBOSE=true

# =============================================================================
# ADVANCED SETTINGS (Optional)
# =============================================================================

# LLM Temperature (0.0 - 2.0)
RAG_TEMPERATURE=0.7

# LLM Max Tokens
RAG_MAX_TOKENS=2000

# Enable reranking (true/false)
RAG_ENABLE_RERANKING=false

# Reranker model (cross-encoder/ms-marco-MiniLM-L-6-v2, etc.)
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Search type (similarity, mmr)
RAG_SEARCH_TYPE=similarity

# Embedding batch size
RAG_EMBEDDING_BATCH_SIZE=100

# Cache directory
RAG_CACHE_DIR=./cache

# =============================================================================
# NOTES
# =============================================================================

# 1. Only set the API keys for the providers you plan to use
# 2. For local models (Ollama), no API key is needed
# 3. ChromaDB and FAISS work locally without cloud API keys
# 4. The pipeline will auto-detect API keys from environment variables
# 5. You can also pass API keys directly in code when creating the pipeline

# =============================================================================
# USAGE
# =============================================================================

# After filling in your keys:
# 1. Rename this file to .env
# 2. The pipeline will automatically load these variables
# 3. Or use: python-dotenv to load manually
#
# In Python:
#   from dotenv import load_dotenv
#   load_dotenv()
#
# Then use the pipeline normally:
#   from pipeline import create_pipeline
#   pipeline = create_pipeline()
